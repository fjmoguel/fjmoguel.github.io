---
// FOOTER — appears on every page. Edit links in src/data/site.js
import { site, nav, socials } from "../data/site.js";
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="wrap ftr-inner">
    <div class="ftr-brand">
      <p class="ftr-name">{site.name}</p>
      <p class="ftr-tag">{site.tagline}</p>
    </div>

    <nav class="ftr-cols">
      <div>
        <h4>Pages</h4>
        {nav.filter((n) => !n.href.includes("#")).map((n) => (
          <a href={n.href}>{n.label}</a>
        ))}
      </div>
      <div>
        <h4>Elsewhere</h4>
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener">{s.label}</a>
        ))}
      </div>
    </nav>
  </div>
  <div class="wrap ftr-base">
    <span>&copy; {year} {site.name}. All rights reserved.</span>
    <span>Built with Astro.</span>
  </div>
</footer>

<style>
  .ftr {
    margin-top: 80px;
    background: var(--paper-deep);
    color: var(--ink);
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--line);
  }
  .ftr-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    justify-content: space-between;
    padding-top: 56px;
    padding-bottom: 40px;
  }
  .ftr-name {
    font-family: var(--display);
    font-size: 1.6rem;
    margin: 0 0 6px;
    font-weight: 600;
  }
  .ftr-tag { color: var(--ink-faint); max-width: 32ch; margin: 0; }

  .ftr-cols { display: flex; gap: 64px; flex-wrap: wrap; }
  .ftr-cols h4 {
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-deep);
    margin: 0 0 14px;
  }
  .ftr-cols a {
    display: block;
    color: var(--ink);
    font-size: 0.95rem;
    padding: 4px 0;
    opacity: 0.75;
  }
  .ftr-cols a:hover { opacity: 1; color: var(--accent-deep); }

  .ftr-base {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 22px;
    padding-bottom: 28px;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
  }
</style>