---
// SLIDESHOW — auto-rotating image display.
// Props: images (array of paths), fit ("cover" | "contain")
const { images = [], fit = "cover" } = Astro.props;
---

<div class="slideshow" data-slideshow style={`--fit:${fit}`}>
  {images.map((src, i) => (
    <div
      class="slide"
      data-slide
      data-active={i === 0 ? "true" : "false"}
      style={`background-image:url('${src}')`}
    ></div>
  ))}
  {images.length === 0 && <div class="slide-empty">No images yet</div>}
</div>

<style>
  .slideshow {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    background: #14130f;
    box-shadow: var(--shadow);
  }
  .slide {
    position: absolute;
    inset: 0;
    background-position: center;
    background-size: var(--fit);
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity 1.1s ease-in-out;
  }
  .slide[data-active="true"] { opacity: 1; }
  .slide-empty {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--ink-faint);
    font-size: 0.9rem;
  }
</style>

<script>
  document.querySelectorAll("[data-slideshow]").forEach((box) => {
    const slides = box.querySelectorAll("[data-slide]");
    if (slides.length < 2) return;
    let i = 0;
    setInterval(() => {
      slides[i].setAttribute("data-active", "false");
      i = (i + 1) % slides.length;
      slides[i].setAttribute("data-active", "true");
    }, 5000);
  });
</script>
